# MITRA — Environment Variable Template
#
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env`. NEVER paste real credentials into chat, issues, or PRs.
# If a credential is ever exposed, rotate it immediately — removing it from a
# file does not un-leak it.
#
# Full documentation of every variable lands in ENVIRONMENT.md (Phase 11).

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# ─── AI provider ─────────────────────────────────────────────────────────────
# The application accesses AI through a provider-agnostic interface.
# If AI_API_KEY is absent, the system falls back to deterministic rule-based
# logic so the app remains fully functional without a key.
AI_PROVIDER=gemini
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gemini-3.1-flash-lite
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=2048

# ─── Google Cloud services ───────────────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-service-account.json
GOOGLE_VISION_API_KEY=your_vision_api_key_here
GOOGLE_STT_API_KEY=your_stt_api_key_here
GOOGLE_TTS_API_KEY=your_tts_api_key_here
GOOGLE_MAPS_API_KEY=your_maps_api_key_here

# ─── Authentication ──────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=your_oauth_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_oauth_client_secret_here
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_long_random_string_here

# JWT — citizen and admin tokens use SEPARATE secrets and audiences so a
# citizen token can never be replayed against an admin endpoint.
JWT_CITIZEN_SECRET=generate_a_long_random_string_here
JWT_ADMIN_SECRET=generate_a_different_long_random_string_here
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://mitra:password@localhost:5432/mitra
POSTGRES_USER=mitra
POSTGRES_PASSWORD=change_me
POSTGRES_DB=mitra

# Encryption key for PII fields at rest (32-byte, base64-encoded)
DATA_ENCRYPTION_KEY=generate_a_32_byte_base64_key_here

# ─── Cache / queue ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Vector store ────────────────────────────────────────────────────────────
VECTOR_STORE=chroma
CHROMA_URL=http://localhost:8001
EMBEDDING_MODEL=text-embedding-004

# ─── Security ────────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
CAPTCHA_SITE_KEY=your_captcha_site_key_here
CAPTCHA_SECRET_KEY=your_captcha_secret_key_here
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── Notifications ───────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user_here
SMTP_PASSWORD=your_smtp_password_here
NOTIFICATION_FROM_EMAIL=noreply@mitra.example

# ─── Localization ────────────────────────────────────────────────────────────
DEFAULT_LOCALE=hi
SUPPORTED_LOCALES=hi,en,bn,ta,mr

# ─── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=info
# PII must never be written to logs regardless of level.
