# MITRA — environment template
#
# Copy to frontend/.env for local development and mirror the same keys in the Vercel
# project settings. Never commit a filled-in copy: .gitignore covers .env and .env.*
# at any depth, and CI fails the build if one is ever tracked.

# ─── Database ────────────────────────────────────────────────────────────────
# Postgres. In production use the POOLED Neon connection string — a serverless
# function opens a connection per invocation and will exhaust a direct one.
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-rough-breeze-axt8b5ok-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_API_URL=https://ep-rough-breeze-axt8b5ok.apirest.c-4.us-east-2.aws.neon.tech/neondb/rest/v1
NEON_AUTH_URL=https://ep-rough-breeze-axt8b5ok.neonauth.c-4.us-east-2.aws.neon.tech/neondb/auth
NEON_JWKS_URL=https://ep-rough-breeze-axt8b5ok.neonauth.c-4.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json

# ─── Storage (S3-compatible) ──────────────────────────────────────────────────
AWS_ENDPOINT_URL_S3="https://br-hidden-boat-axes9pao.storage.c-4.us-east-2.aws.neon.tech"
AWS_ACCESS_KEY_ID="nak_live_your_key_id"
AWS_SECRET_ACCESS_KEY="nsk_live_your_secret_key"
AWS_REGION="us-east-2"

# ─── Session signing ─────────────────────────────────────────────────────────
# Two independent keys. Different secrets mean a citizen token is not merely
# unauthorised on an admin route, it is unverifiable — token confusion between the
# two planes is impossible by construction.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_CITIZEN_SECRET=replace-me-with-48-random-bytes-min-32-chars
JWT_ADMIN_SECRET=replace-me-with-a-different-48-random-bytes

# ─── Admin access ────────────────────────────────────────────────────────────
# scrypt:N:r:p:salt:hash — colon-delimited because dotenv expands `$name`.
# Generate: cd frontend && npm run admin:hash -- 'your-password'
ADMIN_OFFICER_ID=officer
ADMIN_PASSWORD_HASH=scrypt:16384:8:1:REPLACE_SALT_B64:REPLACE_HASH_B64

# ─── AI ──────────────────────────────────────────────────────────────────────
# Both optional. Without either, the assistant falls back to the on-device reasoning
# engine and the app stays fully functional. Server-side only — never prefix with
# NEXT_PUBLIC_. Gemini is tried first; Claude is the backup if Gemini is unset, errors,
# or times out.
AI_API_KEY=
AI_MODEL=gemini-3.1-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
